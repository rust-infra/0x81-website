{
  "expo": {
    "name": "MoYan",
    "slug": "moyan-app",
    "version": "1.0.0",
    "scheme": "moyan",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.anonymous.moyanapp",
      "deploymentTarget": "16.4",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.WAKE_LOCK",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.moyanapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "googleClientId": "",
      "googleRedirectUri": "moyan://auth/google"
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "墨言需要使用麦克风进行英语口语练习。"
        }
      ],
      "./plugins/withSwift5Podfile",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "墨言需要使用麦克风进行英语口语练习。",
          "speechRecognitionPermission": "墨言需要使用系统语音识别把你说的话转成文字。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "墨言需要读取你选择的简历或职位图片。",
          "cameraPermission": "墨言需要使用相机拍摄简历或职位图片。"
        }
      ],
      "expo-document-picker"
    ]
  }
}
