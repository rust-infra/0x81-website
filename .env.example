# 部署环境变量模板 —— 用法：cp .env.example .env，然后填值。
#
# 位置：**必须**与 docker-compose.yml 同级（仓库根，即 compose 的"项目目录"）；
#      服务器上是 /root/Projects/0x81-website/.env。scripts/fetch-rust.sh 也从这里读 GH_TOKEN。
#       子目录里的 .env（moyan-web/、moyan-admin/…）是本地 vite dev 用的，与 compose 无关。
# 权限：chmod 600 .env —— 里面是明文密钥，且**不进 git**、**不进 release**，
#       换服务器必须手工重建，git clone 拿不到（和 certs/ 里的私钥同类）。
# 生效：改完要 `docker compose up -d`（只 restart 不够），`docker compose config` 可验证插值。
# 命名：compose 里写的是 `ADMIN_TOKEN=${AUTH_ADMIN_TOKEN:?...}` 这种映射，直接写
#       `ADMIN_TOKEN=` 是**不会**进容器的。前缀分两类：
#         · `AUTH_`  —— 跨产品的共享认证件（`AUTH_JWT_SECRET` / `AUTH_ADMIN_TOKEN`）。
#                        2026-10-02 从 `MOYAN_` 改名而来：它们服务的是「登录」这个跨产品能力，
#                        不再是墨言专属，`MOYAN_` 前缀编码了错误的所有权。
#         · `MOYAN_` —— 墨言自己的部署件（数据目录、OAuth 凭据、CORS 等）。
#         · `REHEARSE_` —— 职演自己的部署件（它自己的库、LLM 兜底、CORS）。
# ⚠️ 改名时**值要原样搬过去，不要重新生成**：`AUTH_JWT_SECRET` 换值会让所有已发出的 token
#    立即失效（已登录用户全部掉线）。

# ── 管理后台 ─────────────────────────────────────────────────────
# → 容器内 ADMIN_TOKEN；管理后台登录页填的就是它（请求头 X-Admin-Token）。
# 留空 → 全站 /api/admin/* 一律 503（"ADMIN_TOKEN is not configured"，
# 后端设计上禁止空密钥放行，所以线上后台打不开多半是这个键没设）。
# ⚠️ 只能是可见 ASCII（0x20-0x7E）：后端用 HeaderValue::to_str() 取请求头，非 ASCII 值会被
#    判成"没带 token"→ **无论输入什么都恒 401**（曾用含 £ 的 token 踩过）；浏览器还会把非 ASCII
#    按 ByteString 编码，两边永远对不上。生成：openssl rand -hex 20
#    也请避开反引号 / $ / 引号 —— dev-run.sh 会 source 本文件。
AUTH_ADMIN_TOKEN=

# ── 认证（跨产品共享）─────────────────────────────────────────────
# ⚠️ `AUTH_JWT_SECRET` **没有默认值**：compose 里写的是 `${AUTH_JWT_SECRET:?...}`，
#    没设就 `docker compose up -d` 直接报错退出。
#    这是 2026-10-02 特意改的——原来写 `${MOYAN_JWT_SECRET:-change-me-in-production}`，
#    漏改的后果是服务**带着假密钥正常启动**、所有 token 验不过，比启动失败难查得多。
#    两个后端（moyan-backend / rehearse-backend）读同一个值，必须 ASCII。
AUTH_JWT_SECRET=

# ── 墨言后端 ─────────────────────────────────────────────────────
# 留空则回落到 compose 的内置默认值（见 docker-compose.yml 的 ${VAR:-默认}）。

# SQLite 数据目录的**宿主侧**路径（compose 把它挂到容器 /data）。
# 留空/不设 = ./moyan-backend/data（仓库内，dev 默认）。
# 生产建议指到独立数据盘，避免库跟系统盘共用：本机填 /data/moyan-data（/data 是 /dev/vdb1）。
# 改了它 = 换挂载源，必须 `docker compose up -d` 重建容器（restart 不行），
# 并先把旧的 moyan.db 拷到新目录，否则新目录会是空库。
MOYAN_DATA_DIR=
MOYAN_DATABASE_BACKEND=sqlite
MOYAN_DATABASE_URL=sqlite:/data/moyan.db
MOYAN_MONGODB_DATABASE=moyan
MOYAN_GOOGLE_CLIENT_ID=
MOYAN_GOOGLE_CLIENT_SECRET=
MOYAN_GOOGLE_REDIRECT_URL=
# 上面这行留空 = compose 默认的 http://localhost:4323/api/auth/google/callback（仅本地可用）。
# 生产建议填 https://moyan.0x81.uk/api/auth/google/callback，并在 Google 控制台登记同一个回调地址。
MOYAN_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,https://moyan.0x81.uk,https://admin-moyan.0x81.uk,https://admin.moyan.0x81.uk

# ── 职演后端（rehearse-backend）───────────────────────────────────
# 与墨言**不共享任何表**：它连自己的库，所以这里没有「留空回落默认值」的余地
# ——下面第一个键是必填。
#
# 后端**由 scheme 选**（§7.3.5，见 internal/store/open.go）：postgres:// → 托管
# Postgres；sqlite: → 本地/单机 SQLite 文件。只认显式 scheme，裸路径会被拒绝
# （打错一个字母就静默在别处新建一个空库，比启动失败难查得多）。

# ── 生产：Supabase 的 **pooler** 连接串（端口 6543，transaction 模式）──
# ⚠️ 三件事必须同时满足，否则会在连上 Supabase 时才炸（本地 PG 测不出来）：
#    · 用 pooler 端口 6543，不是直连端口 5432
#    · 带 `sslmode=require`（Supabase 强制 TLS）
#    · 带 `default_query_exec_mode=exec`（pgx v5 参数名；不写会被自动补上，
#      但写错了会直接报错退出——见 internal/store/postgres.go）
# 例：postgres://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
#
# ── 单机 / 本地：SQLite（**默认**，§7.3.5）──────────────────────
# 这个键**留空就等于用 SQLite**：compose 里回落 `sqlite:/data/rehearse.db`，
# 宿主进程（go run / make run）回落 `sqlite:./data/rehearse.db`。
# 例：sqlite:/data/rehearse.db        （容器里；compose 已挂 rehearse-data 卷）
#     sqlite:./data/rehearse.db       （宿主进程；`make run` / `run-sqlite` 会建目录）
# ⚠️ 两条限制：**只能单副本**（多进程写同一文件靠文件锁，跨容器/网络卷会静默
#    失效，§7.3.1），且**必须挂卷**，否则容器重建时数据一起没。
# ⚠️ 目录不会自动创建：SQLite 不会替你建父目录，缺了直接
#    `unable to open database file`。先 `mkdir -p`（或跑 `make migrate-up-sqlite`）。
# ⚠️ 用 SQLite 时**不用**跑 Postgres 的迁移，两套迁移按方言分目录
#    （migrations/postgres/ 与 migrations/sqlite/），`cmd/migrate` 自己挑。
# ⚠️ 默认值把「生产漏配」从启动失败变成静默跑单副本 SQLite——所以启动会打
#    WARN、`/health` 会带 `database_defaulted:true`。生产请显式写上面的 pooler。
REHEARSE_DATABASE_URL=

# LLM 配置的 **env 兜底**（§7.3.2）。权威来源是数据库里的 rehearse_settings，
# 由管理后台写；这三个只保证「库还没配好 / 不可达」时服务仍能起来。
REHEARSE_LLM_BASE_URL=
REHEARSE_LLM_API_KEY=
REHEARSE_LLM_MODEL=

# 职演的 CORS 白名单。它没有 Web 客户端（只做 App，RN 的 fetch 不带 Origin），
# 这个键主要是给管理后台用的——后台的「职演」区块跨域调
# /api/admin/settings/rehearse，Origin 不在列表里会被拦。
REHEARSE_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,https://moyan.0x81.uk,https://admin-moyan.0x81.uk,https://admin.moyan.0x81.uk,https://rehearse.0x81.uk

# ── 日志 ────────────────────────────────────────────────────────
RUST_LOG=info

# ── 采集代理（默认值与 compose 一致，一般不用写）────────────────────
# 容器内 127.0.0.1 是容器自己，所以走 host-gateway；宿主 Clash 只听 127.0.0.1:7890，
# 由宿主上的 socat 转发到 172.24.0.1:17890（见 docker-compose.yml 的注释）。
#
# ⚠️ 这几行**故意注释掉**：compose 会把 .env 里的键注入自己的进程环境，而 docker CLI 也读
# HTTP(S)_PROXY 去拉镜像 —— 一旦在这里激活，宿主的 docker pull 就会去连
# host.docker.internal:17890（宿主上通常解析不到这个名字）而失败。
# 确认代理确实需要覆盖默认值时，再取消注释。
# MOYAN_YTDLP_PROXY=http://host.docker.internal:17890
# HTTP_PROXY=http://host.docker.internal:17890
# HTTPS_PROXY=http://host.docker.internal:17890
# ALL_PROXY=http://host.docker.internal:17890
# auth.kimi.com 必须直连；compose 默认已经把它加入 NO_PROXY。
# NO_PROXY=auth.kimi.com,localhost,127.0.0.1,::1,host.docker.internal

# ── 部署脚本（不插值进容器）────────────────────────────────────────
# fetch-rust.sh 下载 GitHub Release 资产用：fine-grained PAT，权限只需 Contents: Read
# （仓库是 private，直链下载不带凭证会 404，所以必须走 api.github.com）。
GH_TOKEN=
