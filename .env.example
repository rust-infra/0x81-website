# 部署环境变量模板 —— 用法：cp .env.example .env，然后填值。
#
# 位置：**必须**与 docker-compose.yml 同级（仓库根，即 compose 的"项目目录"）；
#      服务器上是 /root/Projects/0x81-website/.env。scripts/fetch-rust.sh 也从这里读 GH_TOKEN。
#       子目录里的 .env（moyan-web/、moyan-admin/…）是本地 vite dev 用的，与 compose 无关。
# 权限：chmod 600 .env —— 里面是明文密钥，且**不进 git**、**不进 release**，
#       换服务器必须手工重建，git clone 拿不到（和 certs/ 里的私钥同类）。
# 生效：改完要 `docker compose up -d`（只 restart 不够），`docker compose config` 可验证插值。
# 命名：键名必须是 MOYAN_ 前缀 —— compose 里写的是 ADMIN_TOKEN=${MOYAN_ADMIN_TOKEN:-} 这种映射，
#       直接写 ADMIN_TOKEN= 是**不会**进容器的。

# ── 管理后台 ─────────────────────────────────────────────────────
# → 容器内 ADMIN_TOKEN；管理后台登录页填的就是它（请求头 X-Admin-Token）。
# 留空 → 全站 /api/admin/* 一律 503（"ADMIN_TOKEN is not configured"，
# 后端设计上禁止空密钥放行，所以线上后台打不开多半是这个键没设）。
# ⚠️ 只能是可见 ASCII（0x20-0x7E）：后端用 HeaderValue::to_str() 取请求头，非 ASCII 值会被
#    判成"没带 token"→ **无论输入什么都恒 401**（曾用含 £ 的 token 踩过）；浏览器还会把非 ASCII
#    按 ByteString 编码，两边永远对不上。生成：openssl rand -hex 20
#    也请避开反引号 / $ / 引号 —— dev-run.sh 会 source 本文件。
MOYAN_ADMIN_TOKEN=

# ── 墨言后端 ─────────────────────────────────────────────────────
# 留空则回落到 compose 的内置默认值（见 docker-compose.yml 的 ${VAR:-默认}）。
MOYAN_JWT_SECRET=
MOYAN_DATABASE_BACKEND=sqlite
MOYAN_DATABASE_URL=sqlite:/data/moyan.db
MOYAN_MONGODB_DATABASE=moyan
MOYAN_GOOGLE_CLIENT_ID=
MOYAN_GOOGLE_CLIENT_SECRET=
MOYAN_GOOGLE_REDIRECT_URL=
# 上面这行留空 = compose 默认的 http://localhost:4323/api/auth/google/callback（仅本地可用）。
# 生产建议填 https://moyan.0x81.uk/api/auth/google/callback，并在 Google 控制台登记同一个回调地址。
MOYAN_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:5001,https://moyan.0x81.uk,https://admin-moyan.0x81.uk,https://admin.moyan.0x81.uk

# ── 日志 ────────────────────────────────────────────────────────
RUST_LOG=info

# ── 采集代理（默认值与 compose 一致，一般不用写）────────────────────
# 容器内 127.0.0.1 是容器自己，所以走 host-gateway；宿主 Clash 只听 127.0.0.1:7890，
# 由宿主上的 socat 转发到 172.24.0.1:17890（见 docker-compose.yml 的注释）。
#
# ⚠️ 这几行**故意注释掉**：compose 会把 .env 里的键注入自己的进程环境，而 docker CLI 也读
# HTTP(S)_PROXY 去拉镜像 —— 一旦在这里激活，宿主的 docker pull 就会去连
# host.docker.internal:17890（宿主上通常解析不到这个名字）而失败。
# 确认代理确实需要覆盖默认值时，再取消注释。
# MOYAN_YTDLP_PROXY=http://host.docker.internal:17890
# HTTP_PROXY=http://host.docker.internal:17890
# HTTPS_PROXY=http://host.docker.internal:17890
# ALL_PROXY=http://host.docker.internal:17890
# auth.kimi.com 必须直连；compose 默认已经把它加入 NO_PROXY。
# NO_PROXY=auth.kimi.com,localhost,127.0.0.1,::1,host.docker.internal

# ── 部署脚本（不插值进容器）────────────────────────────────────────
# fetch-rust.sh 下载 GitHub Release 资产用：fine-grained PAT，权限只需 Contents: Read
# （仓库是 private，直链下载不带凭证会 404，所以必须走 api.github.com）。
GH_TOKEN=
