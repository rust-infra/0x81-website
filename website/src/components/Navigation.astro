---
// Navigation.astro — Top navigation bar

export interface Props {
  t: Record<string, any>;
  currentLang: string;
}

const { t, currentLang } = Astro.props;
const otherLang = currentLang === "en" ? "zh" : "en";
const otherLabel = currentLang === "en" ? "中文" : "English";
const indexHref = currentLang === "zh" ? "http://0x81.uk/zh" : "http://0x81.uk/";
---

<nav class="top-nav">
  <div class="container nav-inner">
    <div class="brand-group">
      <a href={indexHref} class="parent-brand">{t.nav.index}</a>
      <span class="brand-sep" aria-hidden="true">/</span>
      <a href="/" class="logo">
        <span class="logo-icon">[t]</span>
        <span class="logo-text">tact</span>
      </a>
    </div>

    <div class="nav-links">
      <a href="#features">{t.nav.features}</a>
      <a href="#install">{t.nav.install}</a>
      <a href="https://github.com/rust-infra/tact" target="_blank" rel="noopener">{t.nav.github} ↗</a>
      <a href={otherLang === "zh" ? "/zh" : "/"} class="lang-switch">{otherLabel}</a>
    </div>
  </div>
</nav>

<style>
  .top-nav {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3rem;
  }
  .brand-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
  }
  .parent-brand {
    color: var(--border);
    font-size: 0.85rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .parent-brand:hover {
    color: var(--accent);
    text-decoration: none;
  }
  .brand-sep {
    color: var(--border);
    opacity: 0.6;
    font-size: 0.85rem;
  }
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--fg);
    font-weight: 600;
  }
  .logo:hover { text-decoration: none; }
  .logo-icon {
    color: var(--accent);
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.85rem;
  }
  .lang-switch {
    border-left: 1px solid var(--border);
    padding-left: 1rem;
    font-size: 0.8rem;
    color: var(--border);
  }
  .lang-switch:hover { color: var(--accent); }

  @media (max-width: 600px) {
    .logo-text { display: none; }
    .nav-links { gap: 0.75rem; font-size: 0.8rem; }
  }
</style>
