---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBar from "../components/StatusBar.astro";
import Navigation from "../components/Navigation.astro";
import Hero from "../components/Hero.astro";
import ValueProps from "../components/ValueProps.astro";
import Features from "../components/Features.astro";
import Install from "../components/Install.astro";
import BridgePreview from "../components/BridgePreview.astro";
import Footer from "../components/Footer.astro";

import en from "../i18n/en.json" with { type: "json" };

const t = en;
---

<BaseLayout title={t.site.title} description={t.site.description}>
  <StatusBar slot="status-bar" />
  <Navigation slot="nav" {t} currentLang="en" />
  <Hero {t} />
  <ValueProps {t} />
  <Features {t} />
  <Install {t} />
  <BridgePreview {t} />
  <Footer slot="footer" {t} />
</BaseLayout>

<script>
  document.addEventListener("click", (e) => {
    if (!(e.target instanceof Element)) return;
    const btn = e.target.closest("[data-copy]");
    if (!(btn instanceof HTMLElement)) return;

    const id = btn.getAttribute("data-copy");
    const el = id ? document.getElementById(id) : null;
    if (!el) return;

    const text = el.textContent.trim();

    // 原始文案只记一次。连点第二次时 btn.textContent 已经是「✓ Copied!」，
    // 再把它当 original 会把按钮永久留在已复制状态。
    const showCopied = () => {
      if (btn.dataset.originalLabel === undefined) {
        btn.dataset.originalLabel = btn.textContent ?? "";
      }
      const pending = btn.dataset.copyTimer;
      if (pending) clearTimeout(Number(pending));
      btn.textContent = "✓ Copied!";
      btn.dataset.copyTimer = String(
        setTimeout(() => {
          btn.textContent = btn.dataset.originalLabel ?? "";
          delete btn.dataset.copyTimer;
        }, 2000)
      );
    };

    navigator.clipboard.writeText(text).then(showCopied).catch(() => {
      const ta = document.createElement("textarea");
      ta.value = text;
      ta.style.position = "fixed";
      ta.style.opacity = "0";
      document.body.appendChild(ta);
      ta.select();
      document.execCommand("copy");
      document.body.removeChild(ta);
      showCopied();
    });
  });
</script>
